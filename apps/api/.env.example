# API Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:root@localhost:5434/todoapp
RUN_MIGRATIONS=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# JWT Configuration
JWT_SECRET=super-secret-worklane-access-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-worklane-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Data Seeding Credentials (Used when running `pnpm seed`)
SEED_ADMIN_EMAIL=admin@worklane.dev
SEED_ADMIN_PASSWORD=WorklaneAdmin2026!

# Upload & File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# S3 / MinIO Object Storage Configuration (Optional: fallback to UPLOAD_DIR if unset)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=worklane-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# Rate Limiting Configuration
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Background Jobs & Socket Clustering (BullMQ & Socket.IO via Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=10
JOB_DEFAULT_MAX_RETRIES=3
JOB_BACKOFF_DELAY_MS=1000
JOB_STALE_PROCESSING_MINUTES=15
