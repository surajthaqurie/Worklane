# API Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:root@localhost:5434/todoapp

# JWT Configuration
JWT_SECRET=super-secret-worklane-access-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-worklane-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Data Seeding Credentials (Used when running `pnpm seed`)
SEED_ADMIN_EMAIL=admin@worklane.dev
SEED_ADMIN_PASSWORD=WorklaneAdmin2026!

# Upload & File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting Configuration
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
